<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskManagerApp.Views.MainPage"
             Title="Tasks">
    <ContentPage.Content>
        <VerticalStackLayout Padding="12" Spacing="12">
            <Label Text="{Binding Quote}" LineBreakMode="WordWrap"/>
            <Button Text="Fetch Quote" Command="{Binding FetchQuoteCommand}" />

            <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,6" CornerRadius="6" >
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Title}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding DueDate, StringFormat='{0:MMM dd, yyyy}'}" Grid.Row="1" Grid.Column="0" />
                                <Switch IsToggled="{Binding IsCompleted}" Grid.Row="0" Grid.Column="1" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Task" Clicked="OnAddTaskClicked" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
