<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskManagerApp.Views.MainPage"
             Title="Tasks"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20"
          RowSpacing="15">

        <!--  HEADER -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Label Text="Task Manager" 
                   Style="{StaticResource Headline}" 
                   HorizontalOptions="Center" />

            <!--  Theme Toggle Switch -->
            <HorizontalStackLayout HorizontalOptions="End">
                <Label Text="" VerticalOptions="Center" />
                <Switch x:Name="ThemeSwitch"
                        Toggled="ThemeSwitch_Toggled"
                        VerticalOptions="Center"
                        Margin="5,0"/>
                <Label Text="" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!--  Motivational Quote -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}"
                   CornerRadius="10"
                   Padding="10"
                   HasShadow="True">
                <Label Text="{Binding Quote}"
                       TextColor="{DynamicResource TextColor}"
                       FontAttributes="Italic"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
            </Frame>

            <Button Text="Fetch Quote"
                    Command="{Binding FetchQuoteCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}" />

        </VerticalStackLayout>

        <!--  TASK LIST (Scrollable) -->
        <ScrollView Grid.Row="1">
            <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12"
                               Margin="0,6"
                               CornerRadius="10"
                               HasShadow="True"
                               BackgroundColor="{DynamicResource CardBackgroundColor}">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="5">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextColor}" />
                                <Switch Grid.Row="0"
                                        Grid.Column="1"
                                        IsToggled="{Binding IsCompleted}"
                                        VerticalOptions="Center" />
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding DueDate, StringFormat='Due: {0:MMM dd, yyyy}'}"
                                       FontSize="13"
                                       TextColor="{DynamicResource SecondaryTextColor}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- STICKY ADD TASK BUTTON -->
        <Button Grid.Row="2"
                Text="Add Task"
                Clicked="OnAddTaskClicked"
                Style="{DynamicResource PrimaryButtonStyle}"
                Margin="0,10,0,0" />
    </Grid>
</ContentPage>
